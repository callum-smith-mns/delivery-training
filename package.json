{
  "name": "delivery-training",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --workspace api run dev",
    "start:api": "npm --workspace api run start",
    "dev:full": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev -- --host 127.0.0.1 --port 4173\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "npm --workspace api run test",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
