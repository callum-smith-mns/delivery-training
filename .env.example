# Copy to `.env` (or `.env.production`) and set the API host the built frontend
# should call. Leave empty to use same-origin/relative requests (default).
# Example for a separate production API:
# VITE_API_BASE_URL=https://api.example.com
#
# Hosted under a subfolder: set this to the path prefix AND start the API with a
# matching BASE_PATH (e.g. `BASE_PATH=/something-non-standard npm run dev:api`).
# In dev the Vite proxy forwards `<prefix>/api` to the API automatically.
# VITE_API_BASE_URL=/something-non-standard
VITE_API_BASE_URL=
